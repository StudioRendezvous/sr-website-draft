# Studio Rendezvous, Inc. static site (replaces the WordPress .htaccess)
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# One address: https, no www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://studiorendezvous.net%{REQUEST_URI} [L,R=301]

# Old WordPress pages (root and /staging/) to the matching section of the new page
RewriteRule ^(staging/)?services/?$ /#make [NE,L,R=301]
RewriteRule ^(staging/)?(work|norton-video|branding-examples|3d-examples|ux-ui-examples|motion-design-examples)/?$ /#work [NE,L,R=301]
RewriteRule ^(staging/)?about/?$ /#together [NE,L,R=301]
RewriteRule ^(staging/)?contact/?$ /#contact [NE,L,R=301]

# Everything else from the old site: the /staging/ path, feeds and WordPress sitemaps
RewriteRule ^staging(/.*)?$ / [L,R=301]
RewriteRule ^((comments/)?feed/?|wp-sitemap.*\.xml)$ / [L,R=301]
</IfModule>

# Compression and caching
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/ld+json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 day"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
